{
  "expo": {
    "name": "ShadowChat",
    "slug": "shadowchat-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shadowchat",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.shadowchat.mobile"
    },
    "android": {
      "package": "com.shadowchat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "ios": {
            "backgroundColor": "#050505"
          },
          "android": {
            "backgroundColor": "#050505",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E9C766",
          "defaultChannel": "shadowchat_sound_shadow_whisper_v2",
          "sounds": [
            "./assets/sounds/shadow_whisper.wav",
            "./assets/sounds/low_glass.wav",
            "./assets/sounds/gold_signal.wav",
            "./assets/sounds/hype_burst.wav",
            "./assets/sounds/pin_shutter.wav",
            "./assets/sounds/connection_chime.wav",
            "./assets/sounds/presence_pulse.wav",
            "./assets/sounds/live_beacon.wav",
            "./assets/sounds/checkers_move.wav",
            "./assets/sounds/war_drum.wav",
            "./assets/sounds/weather_glass.wav",
            "./assets/sounds/security_signal.wav"
          ]
        }
      ]
    ],
    "extra": {
      "webAppUrl": "https://shadochat.online"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
