{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "streamlined": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "channel": "streamlined",
      "env": {
        "SHADOWCHAT_APP_EDITION": "streamlined",
        "SHADOWCHAT_STREAMLINED_WEB_ORIGIN": "https://shadowchat-streamlined.netlify.app",
        "SHADOWCHAT_IOS_BUILD_NUMBER": "25",
        "SHADOWCHAT_DEMO_COMMUNITY_ENABLED": "true",
        "SHADOWCHAT_DEMO_WEB_ORIGIN": "https://shadowchat-review-demo.netlify.app",
        "SHADOWCHAT_DEMO_PROJECT_REF": "lzmbwrbvtugqnmuefdrm",
        "EXPO_PUBLIC_DEMO_SUPABASE_URL": "https://lzmbwrbvtugqnmuefdrm.supabase.co",
        "EXPO_PUBLIC_DEMO_SUPABASE_KEY": "sb_publishable_h-nPlfvK2mq9avGohB1kpQ__6MrSX9f",
        "EXPO_PUBLIC_PRIVATE_REALTIME_ENABLED": "true"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "autoIncrement": false,
      "node": "24.15.0",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6792533179",
        "appleTeamId": "89M6KGXTBS",
        "bundleIdentifier": "com.shadowchat.mobile",
        "groups": [
          "ShadoChat Internal Beta"
        ]
      }
    }
  }
}
