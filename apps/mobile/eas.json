{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6792533179",
        "appleTeamId": "89M6KGXTBS",
        "bundleIdentifier": "com.shadowchat.mobile"
      }
    }
  }
}
