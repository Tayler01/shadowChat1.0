EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Remains false for the full app. Enable only after private channel policies
# have been deployed and verified for the target backend.
EXPO_PUBLIC_PRIVATE_REALTIME_ENABLED=false

# The EAS streamlined profile supplies these automatically.
# SHADOWCHAT_APP_EDITION=streamlined
# SHADOWCHAT_STREAMLINED_WEB_ORIGIN=https://shadowchat-streamlined.netlify.app
# SHADOWCHAT_IOS_BUILD_NUMBER=18
