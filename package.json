{
  "name": "realtime-chat-platform",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-build-health-manifest.mjs && node scripts/verify-paused-feature-build.mjs && node scripts/verify-build-budgets.mjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "jest",
    "test:node": "node --test tests/buildBudgets.node.test.mjs tests/edgeRequestGuards.node.test.mjs tests/mobileHeaderOverlay.node.test.mjs tests/netlifySafeFetch.node.test.mjs tests/netlifySecurityHeaders.node.test.mjs tests/newsScraperSelection.node.test.mjs tests/operationsHealth.node.test.mjs tests/productionHealth.node.test.mjs tests/serviceWorkerCaching.node.test.mjs tests/shadowRunnerRuntimeAssets.node.test.mjs tests/supabaseFunctionManifest.node.test.mjs tests/supabaseSecurityDefinerAllowlist.node.test.mjs tests/weatherSavedLocationsSql.node.test.mjs",
    "supabase:security-contract:local": "node scripts/verify-supabase-security-contract.mjs",
    "supabase:security-contract:linked": "node scripts/verify-supabase-security-contract.mjs --linked",
    "supabase:functions:verify": "node scripts/deploy-supabase-functions.mjs",
    "supabase:functions:deploy": "node scripts/deploy-supabase-functions.mjs --deploy",
    "supabase:bridge-auth:pause": "node scripts/pause-bridge-auth-users.mjs --apply",
    "supabase:bridge-auth:verify": "node scripts/deploy-supabase-functions.mjs --verify-bridge-auth-hold",
    "docs:verify": "node scripts/verify-docs-integrity.mjs",
    "qa:smoke": "node scripts/playwright-smoke.mjs",
    "qa:smoke:headed": "node scripts/playwright-smoke.mjs --headed",
    "qa:smoke:auth": "node scripts/playwright-smoke.mjs --scenario=auth",
    "qa:smoke:dm": "node scripts/playwright-smoke.mjs --scenario=dm",
    "qa:smoke:resume": "node scripts/playwright-smoke.mjs --scenario=resume-send",
    "qa:smoke:prod": "node scripts/playwright-smoke.mjs --base-url=https://shadochat.online --scenario=auth,resume-send --account-mode=env --run-name=prod-postdeploy --headed --slow-mo=300",
    "qa:smoke:prod:headless": "node scripts/playwright-smoke.mjs --base-url=https://shadochat.online --scenario=auth,resume-send --account-mode=env --run-name=prod-postdeploy-headless",
    "qa:smoke:prod:headed": "node scripts/playwright-smoke.mjs --base-url=https://shadochat.online --scenario=auth,resume-send --account-mode=env --run-name=prod-postdeploy-headed --headed --slow-mo=300",
    "qa:smoke:mobile": "node scripts/playwright-smoke.mjs --scenario=mobile-dm-back",
    "qa:smoke:full": "node scripts/playwright-smoke.mjs --scenario=full",
    "qa:shadow-war": "node scripts/shadow-war-db-smoke.mjs",
    "qa:shadow-war:core": "node scripts/shadow-war-db-smoke.mjs --skip-queue",
    "qa:shadow-war:visual": "node scripts/shadow-war-visual-playtest.mjs",
    "qa:shadow-checkers": "node scripts/shadow-checkers-db-smoke.mjs",
    "qa:shadow-runner": "node scripts/shadow-runner-phone-smoke.mjs",
    "qa:shadow-runner:level5": "node scripts/shadow-runner-phone-smoke.mjs --level=level-5 --profiles=landscape,android",
    "qa:shadow-runner:level6": "node scripts/shadow-runner-phone-smoke.mjs --level=level-6 --profiles=landscape,android",
    "qa:shadow-runner:level7": "node scripts/shadow-runner-phone-smoke.mjs --level=level-7 --profiles=landscape,android",
    "news:scrape:proof": "node services/news-scraper/src/index.mjs --proof",
    "news:scraper": "node services/news-scraper/src/index.mjs",
    "bridge:tui": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bridge-tui/bridge-tui.ps1",
    "bridge:tui:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bridge-tui/bridge-tui.ps1 -Smoke",
    "bridge:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/bridge-tui/bridge-bundle-receive.ps1",
    "bridge:bundle:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-bridge-bundle.ps1",
    "bridge:tui:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-bridge-tui-layout.ps1",
    "qa:smoke:full:headed": "node scripts/playwright-smoke.mjs --scenario=full --headed",
    "qa:chat-scroll": "node scripts/group-chat-scroll-probe.mjs",
    "qa:chat-scroll:metrics": "node scripts/group-chat-scroll-probe.mjs --scenario=metrics",
    "qa:chat-scroll:all": "node scripts/group-chat-scroll-probe.mjs --scenario=all",
    "qa:mobile-pwa": "node scripts/mobile-pwa-visual-qa.mjs",
    "qa:final-acceptance-mobile": "node scripts/verify-final-acceptance-mobile.mjs",
    "qa:shadow-pin-feed-modes": "node scripts/verify-shadow-pin-feed-modes-browser.mjs",
    "qa:inner-circles": "node scripts/verify-inner-circles-browser.mjs",
    "qa:shado-live": "node scripts/verify-shado-live-prototype-browser.mjs",
    "qa:shado-live:real": "node scripts/verify-shado-live-real-browser.mjs",
    "qa:shado-live:provider": "node scripts/verify-shado-live-provider-browser.mjs",
    "qa:catch-up": "node scripts/verify-catch-up-browser.mjs",
    "qa:catch-up:persistence": "node scripts/verify-catch-up-read-persistence.mjs --linked",
    "qa:comfort": "node scripts/comfort-visual-qa.mjs",
    "qa:themes": "node scripts/theme-visual-qa.mjs",
    "automation:submit-daily-scan": "node scripts/submit-daily-scan-approval-packets.mjs",
    "shadow-runner:audio": "node scripts/generate-shadow-runner-audio.mjs",
    "release:publish": "node scripts/publish-app-release.mjs",
    "shadow-pin:backfill-media": "node scripts/shadow-pin-backfill-media.mjs",
    "media:backfill-mobile": "node scripts/backfill-mobile-media.mjs",
    "video:render:trailer": "remotion render src/remotion/index.ts CrimpShrimpTrailer output/shado-tv-remotion/crimp-shrimp-trailer.mp4 --codec=h264 --crf=20",
    "video:render:main": "remotion render src/remotion/index.ts CrimpShrimpLaunchFeaturette output/shado-tv-remotion/crimp-shrimp-main-upload-promo.mp4 --codec=h264 --crf=20",
    "video:render:shado-tv": "npm run video:render:trailer && npm run video:render:main"
  },
  "dependencies": {
    "@sentry/react": "10.64.0",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.0.0",
    "emoji-picker-react": "^4.7.15",
    "framer-motion": "^10.16.16",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "livekit-client": "2.20.1",
    "lucide-react": "^0.344.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^3.8.1",
    "semver": "^7.8.0",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.2.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@remotion/cli": "^4.0.464",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.0.4",
    "playwright": "^1.59.1",
    "postcss": "^8.4.35",
    "remotion": "^4.0.464",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@remotion/renderer": {
      "source-map": "0.7.6"
    },
    "jest-environment-jsdom": {
      "jsdom": "29.1.1"
    },
    "glob": "13.0.6"
  }
}
