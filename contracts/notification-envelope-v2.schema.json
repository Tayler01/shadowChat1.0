{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadowchat.app/contracts/notification-envelope-v2.schema.json",
  "title": "ShadowChat NotificationEnvelopeV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventIds",
    "type",
    "category",
    "entityId",
    "route",
    "groupKey",
    "priority",
    "privacy",
    "actor",
    "content",
    "media",
    "actions",
    "soundId",
    "androidChannelKey",
    "badgeCategory",
    "autoRead",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "category": {
      "enum": [
        "dm",
        "general_chat",
        "mentions_replies",
        "reactions_hype",
        "shadow_pin",
        "connections",
        "presence",
        "shado_live",
        "shadow_checkers",
        "shadow_war",
        "weather",
        "security",
        "system"
      ]
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "route": {
      "type": "string",
      "pattern": "^/(?!/)",
      "maxLength": 1024
    },
    "groupKey": {
      "type": "string",
      "pattern": "^[a-z0-9_:-]+$",
      "minLength": 1,
      "maxLength": 160
    },
    "priority": {
      "enum": ["ambient", "normal", "high", "urgent"]
    },
    "privacy": {
      "enum": ["full", "sender_only", "private"]
    },
    "actor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "avatarUrl"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "avatarUrl": {
              "type": ["string", "null"],
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "body", "privateTitle", "privateBody"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "privateTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "privateBody": {
          "type": ["string", "null"],
          "maxLength": 160
        }
      }
    },
    "media": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "thumbnailUrl", "alt"],
          "properties": {
            "kind": {
              "enum": ["image", "video"]
            },
            "thumbnailUrl": {
              "type": "string",
              "minLength": 1,
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "alt": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["open", "mark_read"]
      }
    },
    "soundId": {
      "enum": [
        "shadow_whisper",
        "low_glass",
        "gold_signal",
        "hype_burst",
        "pin_shutter",
        "connection_chime",
        "presence_pulse",
        "live_beacon",
        "checkers_move",
        "war_drum",
        "weather_glass",
        "security_signal",
        "system_default",
        "silent"
      ]
    },
    "androidChannelKey": {
      "enum": [
        "messages_v1",
        "mentions_v1",
        "social_v1",
        "live_v1",
        "games_v1",
        "weather_v1",
        "security_v1"
      ]
    },
    "badgeCategory": {
      "enum": [
        "dm",
        "group",
        "interactions",
        "connections",
        "shadow_pin",
        "games",
        "none"
      ]
    },
    "autoRead": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
