{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loss-preserving DAT parser output",
  "type": "object",
  "required": [
    "schemaVersion",
    "format",
    "sourceName",
    "sourceSha256",
    "sourceBytes",
    "magicHex",
    "rulesetHint",
    "levelCount",
    "levels",
    "warnings",
    "validationScope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "legacy-dat-raw"
    },
    "sourceName": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBytes": {
      "type": "integer",
      "minimum": 0
    },
    "magicHex": {
      "enum": [
        "0x0002AAAC",
        "0x0102AAAC"
      ]
    },
    "rulesetHint": {
      "enum": [
        "mscc",
        "lynx-hint"
      ]
    },
    "levelCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "recordIndex",
          "sourceLevelNumber",
          "timeLimitSeconds",
          "requiredChips",
          "mapEncoding",
          "width",
          "height",
          "upper",
          "lower",
          "optionalFields",
          "sourceOffset",
          "recordByteLength",
          "recordRawHex",
          "recordSha256",
          "warnings"
        ],
        "properties": {
          "recordIndex": {
            "type": "integer",
            "minimum": 0
          },
          "sourceLevelNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "timeLimitSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "requiredChips": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "mapEncoding": {
            "const": 1
          },
          "width": {
            "const": 32
          },
          "height": {
            "const": 32
          },
          "upper": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 111
            },
            "minItems": 1024,
            "maxItems": 1024
          },
          "lower": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 111
            },
            "minItems": 1024,
            "maxItems": 1024
          },
          "optionalFields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "length",
                "rawHex"
              ],
              "properties": {
                "type": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "rawHex": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{2})*$"
                },
                "text": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "button",
                      "target"
                    ],
                    "properties": {
                      "button": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "target": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 31
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "legacyState": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "actorOrder": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 31
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 31
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "sourceOffset": {
            "type": "integer",
            "minimum": 0
          },
          "recordByteLength": {
            "type": "integer",
            "minimum": 0
          },
          "recordRawHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "recordSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationScope": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
