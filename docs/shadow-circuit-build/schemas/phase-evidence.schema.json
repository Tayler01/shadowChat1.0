{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase evidence, not a substitute for actual logs",
  "type": "object",
  "required": [
    "schemaVersion",
    "phase",
    "buildHash",
    "status",
    "commands",
    "artifacts",
    "blockers",
    "devices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "type": "string",
      "pattern": "^P(?:0[0-9]|1[01])$"
    },
    "buildHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode",
          "logPath"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "logPath": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model",
          "os",
          "browser",
          "mode",
          "physical"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "os": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "browser": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "tab",
              "installed-pwa",
              "desktop",
              "emulated"
            ]
          },
          "physical": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
